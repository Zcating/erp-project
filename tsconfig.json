{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node", "vite/client"],
    "paths": {
      "@/*": ["./packages/web/src/*"]
    }
  },
  "include": ["packages/*/src", "packages/*/*.config.ts", "*.config.ts"]
}
